# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets, but keep .env.example template)
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle migrations (commit these, but ignore local dev state)
# /drizzle - uncomment if you want to ignore local migrations

# skills lock (optional - keep if you use shared skills)
# skills-lock.json

# agent/ECC skills and config (should not be committed)
.agents/
.claude/
.config/opencode/

# graphify output (generated, not committed)
graphify-out/
.graphify_*.json
.graphify_*.txt